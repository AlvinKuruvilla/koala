<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The bundle `just gui` builds around koala-ui. macOS takes the name in
     the app switcher, Dock, and menu bar from CFBundleName, and the icon
     from CFBundleIconFile; a bare executable would show "koala-ui" and a
     generic icon. -->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Koala</string>
    <key>CFBundleDisplayName</key>
    <string>Koala</string>
    <key>CFBundleIdentifier</key>
    <string>dev.koala.browser</string>
    <key>CFBundleExecutable</key>
    <string>koala-ui</string>
    <key>CFBundleIconFile</key>
    <string>Koala</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>0.1.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
