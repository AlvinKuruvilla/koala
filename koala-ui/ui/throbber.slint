// A spinning arc for a loading tab: a port of Chrome's tab throbber.
//
// Source: `PaintThrobberSpinning` in Chromium's `ui/gfx/paint_throbber.cc`,
// https://github.com/chromium/chromium/blob/4ee33521e2d523a21fdf18e49eb1f2a007d740a8/ui/gfx/paint_throbber.cc
// Chromium's comment calls it "a Skia port of the MD spinner SVG".
//
// Slint's stock `Spinner` moves the arc's leading end backwards whenever
// the arc shortens. Here the arc grows from its head and shrinks from its
// tail, and the whole arc keeps rotating, so both ends only move forward.
//
// Names map as follows (Chromium -> here): `kMaxArcSize` -> 270,
// `kArcTime` -> `arc-time-ms`, `kRotationTime` -> `rotation-time-ms`,
// `elapsed_ratio` / `sweep_frame` / `arc_progress` / `start_angle` /
// `sweep` -> the properties of the same names below. Angles are degrees,
// measured clockwise from 3 o'clock, as in Skia.
//
// Implementation note: Chromium times the animation from when the
// throbber starts; this uses Slint's `animation-tick()`, a clock shared by
// every animation, so a new throbber may start partway through a cycle.

export component Throbber {
    in property <brush> color;

    // "The maximum size of the "spinning" state arc, in degrees."
    //     constexpr int64_t kMaxArcSize = 270;
    // "The amount of time it takes to grow the "spinning" arc from 0 to 270
    // degrees."
    //     constexpr auto kArcTime = base::Seconds(2.0 / 3.0);
    private property <float> arc-time-ms: 2000 / 3;
    // "The amount of time it takes for the "spinning" throbber to make a
    // full rotation."
    //     constexpr auto kRotationTime = base::Milliseconds(1568);
    private property <float> rotation-time-ms: 1568;

    private property <float> elapsed-ms: animation-tick() / 1ms;

    // CalculateThrobberSpinningState:
    //     const int64_t start_angle =
    //         270 + base::ClampRound<int64_t>(elapsed_time / kRotationTime * 360);
    private property <float> rotation: 270 + round(elapsed-ms / rotation-time-ms * 360);

    // "The sweep angle ranges from -270 to 270 over 1333ms. CSS animation
    // timing functions apply in between key frames, so we have to break up
    // the 1333ms into two keyframes (-270 to 0, then 0 to 270)."
    //     const double elapsed_ratio = (elapsed_time / kArcTime) + sweep_keyframe_offset;
    //     const int64_t sweep_frame = base::ClampFloor<int64_t>(elapsed_ratio);
    //     const double arc_progress = elapsed_ratio - sweep_frame;
    private property <float> elapsed-ratio: elapsed-ms / arc-time-ms;
    private property <float> sweep-frame: floor(elapsed-ratio);
    private property <float> arc-progress: elapsed-ratio - sweep-frame;

    // "This tween is equivalent to cubic-bezier(0.4, 0.0, 0.2, 1)."
    //     double sweep = kMaxArcSize *
    //                    Tween::CalculateValue(Tween::FAST_OUT_SLOW_IN, arc_progress);
    //     if (sweep_frame % 2 == 0) {
    //       sweep -= kMaxArcSize;
    //     }
    private property <float> raw-sweep:
        270 * eased-progress - (mod(sweep-frame, 2) == 0 ? 270 : 0);

    // "This part makes sure the sweep is at least 5 degrees long. Roughly
    // equivalent to the "magic constants" in SVG's fillunfill animation."
    //     if (sweep >= 0.0 && sweep < kMinSweepLength) {
    //       start_angle -= (kMinSweepLength - sweep);
    //       sweep = kMinSweepLength;
    //     } else if (sweep <= 0.0 && sweep > -kMinSweepLength) {
    //       start_angle += (-kMinSweepLength - sweep);
    //       sweep = -kMinSweepLength;
    //     }
    private property <bool> short-forward: raw-sweep >= 0 && raw-sweep < 5;
    private property <bool> short-backward: raw-sweep <= 0 && raw-sweep > -5;
    private property <float> sweep: short-forward ? 5 : short-backward ? -5 : raw-sweep;
    private property <float> clamped-start:
        short-forward ? rotation - (5 - raw-sweep)
        : short-backward ? rotation + (-5 - raw-sweep)
        : rotation;

    // "To keep the sweep smooth, we have an additional rotation after each
    // arc period has elapsed. See SVG's 'rot' animation."
    //     const int64_t rot_keyframe = (sweep_frame / 2) % 4;
    //     start_angle = start_angle + rot_keyframe * kMaxArcSize;
    private property <float> start-angle: clamped-start + mod(floor(sweep-frame / 2), 4) * 270;

    // PaintArc:
    // "Stroke width depends on size.
    //  . For size < 28:          3 - (28 - size) / 16
    //  . For 28 <= size:         (8 + size) / 12"
    private property <float> size: min(root.width, root.height) / 1px;
    private property <float> stroke-px: size < 28 ? 3 - (28 - size) / 16 : (size + 8) / 12;
    // "Inset by half the stroke width to make sure the whole arc is inside
    // the visible rect."
    //     const int inset = SkScalarCeilToInt(*stroke_width / 2.0);
    private property <float> radius: size / 2 - ceil(stroke-px / 2);
    private property <float> center: size / 2;

    // `Tween::FAST_OUT_SLOW_IN` is `gfx::CubicBezier(0.4, 0, 0.2, 1)`, and
    // `CubicBezier::Solve(x)` returns the curve's y at x. With control
    // points (0.4, 0) and (0.2, 1):
    //     x(s) = 3(1-s)^2 s (0.4) + 3(1-s) s^2 (0.2) + s^3
    //     y(s) = 3(1-s) s^2 + s^3
    // Slint has no loops, so s is found from x = arc-progress by four Newton
    // steps. x'(s) stays at or above 0.525 on [0, 1], so starting from
    // s = x the steps converge; after four, |x(s) - x| is below 3e-9.
    //
    // Each step is its own property, not a nested call: Slint inlines pure
    // functions, and a step uses s three times, so four nested steps expand
    // to an expression large enough to stall rustc on the generated code.
    private property <float> s1: newton-step(arc-progress, arc-progress);
    private property <float> s2: newton-step(s1, arc-progress);
    private property <float> s3: newton-step(s2, arc-progress);
    private property <float> s4: newton-step(s3, arc-progress);
    private property <float> eased-progress: 3 * (1 - s4) * s4 * s4 + s4 * s4 * s4;

    pure function bezier-x(s: float) -> float {
        return 1.2 * s * (1 - s) * (1 - s) + 0.6 * s * s * (1 - s) + s * s * s;
    }
    pure function bezier-dx(s: float) -> float {
        return 1.2 * ((1 - s) * (1 - s) - 2 * s * (1 - s))
            + 0.6 * (2 * s * (1 - s) - s * s)
            + 3 * s * s;
    }
    pure function newton-step(s: float, x: float) -> float {
        return clamp(s - (bezier-x(s) - x) / bezier-dx(s), 0, 1);
    }

    // PaintArc draws `arcTo(oval, start_angle, sweep)` with round caps.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: root.size;
        viewbox-height: root.size;
        stroke: root.color;
        stroke-width: root.stroke-px * 1px;
        stroke-line-cap: round;

        MoveTo {
            x: root.center + root.radius * cos(root.start-angle * 1deg);
            y: root.center + root.radius * sin(root.start-angle * 1deg);
        }

        ArcTo {
            radius-x: root.radius;
            radius-y: root.radius;
            x: root.center + root.radius * cos((root.start-angle + root.sweep) * 1deg);
            y: root.center + root.radius * sin((root.start-angle + root.sweep) * 1deg);
            // A positive sweep runs clockwise, which is the SVG sweep flag.
            sweep: root.sweep > 0;
            large-arc: abs(root.sweep) > 180;
        }
    }
}
